# ============================================
# BEEF RESTAURANT - BACKEND SERVICES
# Environment Variables for K3s Multi-Node Deployment
# (3 Control Nodes + 3 Worker Nodes)
# ============================================

# ============================================
# DISCOVERY SERVICE (Eureka Server)
# ============================================
SERVER_PORT_DISCOVERY=8761
EUREKA_CLIENT_FETCH_REGISTRY=false
EUREKA_CLIENT_REGISTER_WITH_EUREKA=false
EUREKA_SERVER_ENABLE_SELF_PRESERVATION=false
EUREKA_SERVER_EVICTION_INTERVAL=60000
EUREKA_SERVER_RENEWAL_PERCENT_THRESHOLD=0.85
EUREKA_INSTANCE_HOSTNAME=discovery-service.default.svc.cluster.local
MANAGEMENT_ENDPOINTS_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_HEALTH_SHOW_DETAILS=always

# ============================================
# GATEWAY SERVICE (API Gateway)
# ============================================
SERVER_PORT_GATEWAY=9000
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
EUREKA_URI=http://discovery-service.default.svc.cluster.local:8761/eureka/
EUREKA_FETCH_REGISTRY=true
EUREKA_REGISTER_WITH_EUREKA=true
EUREKA_PREFER_IP_ADDRESS=false
EUREKA_INSTANCE_ID=${HOSTNAME}
MANAGEMENT_GATEWAY_ENABLED=true

# ============================================
# USER SERVICE
# ============================================
SERVER_PORT_USER=8085

# Database (Replace H2 with PostgreSQL for production)
DB_URL=jdbc:postgresql://postgres-service.default.svc.cluster.local:5432/userdb
DB_USERNAME=postgres
DB_PASSWORD=<from-k8s-secret>
DB_DRIVER=org.postgresql.Driver

# H2 Console (Disable in production)
H2_CONSOLE_ENABLED=false
H2_CONSOLE_PATH=/h2-console

# JPA/Hibernate
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Flyway
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_BASELINE_ON_MIGRATE=true

# Keycloak
KEYCLOAK_SERVER_URL=http://keycloak-service.default.svc.cluster.local:8180
KEYCLOAK_REALM=master
KEYCLOAK_ISSUER_URI=http://keycloak-service.default.svc.cluster.local:8180/realms/master
KEYCLOAK_CLIENT_ID=beef-restaurant-client
KEYCLOAK_CLIENT_SECRET=<from-k8s-secret>
KEYCLOAK_ADMIN_USER=<from-k8s-secret>
KEYCLOAK_ADMIN_PASSWORD=<from-k8s-secret>

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<from-k8s-secret>
MAIL_PASSWORD=<from-k8s-secret>
MAIL_FROM=noreply@beefrestaurant.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_SSL_PROTOCOLS=TLSv1.2
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000

# RabbitMQ
RABBITMQ_HOST=rabbitmq-service.default.svc.cluster.local
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=<from-k8s-secret>
RABBITMQ_PASSWORD=<from-k8s-secret>
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_CONNECTION_TIMEOUT=10000

# ============================================
# BASKET SERVICE
# ============================================
SERVER_PORT_BASKET=8081

# Redis
REDIS_HOST=redis-service.default.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=<from-k8s-secret>
REDIS_TIMEOUT=60000
REDIS_POOL_MAX_ACTIVE=20
REDIS_POOL_MAX_IDLE=10
REDIS_POOL_MIN_IDLE=2
REDIS_POOL_MAX_WAIT=-1

# ============================================
# MENU SERVICE
# ============================================
SERVER_PORT_MENU=8080

# Database (Replace H2 with PostgreSQL for production)
# DB_URL=jdbc:postgresql://postgres-service.default.svc.cluster.local:5432/menudb
# DB_USERNAME=postgres
# DB_PASSWORD=<from-k8s-secret>
# DB_DRIVER=org.postgresql.Driver
# JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ============================================
# ORDERING SERVICE
# ============================================
SERVER_PORT_ORDERING=8082

# Database (Replace H2 with PostgreSQL for production)
# DB_URL=jdbc:postgresql://postgres-service.default.svc.cluster.local:5432/orderingdb
# DB_USERNAME=postgres
# DB_PASSWORD=<from-k8s-secret>
# DB_DRIVER=org.postgresql.Driver
# JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Application Settings
PAYMENT_TIMEOUT_MINUTES=15

# Logging
LOG_LEVEL_ORDERING=INFO
LOG_LEVEL_AMQP=INFO

# ============================================
# PAYMENT SERVICE
# ============================================
SERVER_PORT_PAYMENT=8083

# PayOS Credentials
PAYOS_CLIENT_ID=<from-k8s-secret>
PAYOS_API_KEY=<from-k8s-secret>
PAYOS_CHECKSUM_KEY=<from-k8s-secret>

# PayOS Callback URLs (Use Ingress URLs for production)
PAYOS_RETURN_URL=https://your-frontend-domain.com/payment-success
PAYOS_CANCEL_URL=https://your-api-domain.com/api/payment/cancel
PAYOS_FE_CANCEL_URL=https://your-frontend-domain.com/payment-cancel

# ============================================
# SHARED CONFIGURATION (All Services)
# ============================================
# These variables are used by multiple services

# Eureka (for all microservices except DiscoveryService)
# EUREKA_URI=http://discovery-service.default.svc.cluster.local:8761/eureka/
# EUREKA_FETCH_REGISTRY=true
# EUREKA_REGISTER_WITH_EUREKA=true
# EUREKA_PREFER_IP_ADDRESS=false
# EUREKA_INSTANCE_ID=${HOSTNAME}

# Keycloak (for all services with OAuth2)
# KEYCLOAK_ISSUER_URI=http://keycloak-service.default.svc.cluster.local:8180/realms/master

# Management/Actuator (for all services)
# MANAGEMENT_ENDPOINTS_INCLUDE=health,info,metrics,prometheus
# MANAGEMENT_HEALTH_SHOW_DETAILS=always

# ============================================
# NOTES FOR K3S DEPLOYMENT
# ============================================
# 1. Replace "default" namespace with your actual namespace
# 2. Service DNS format: <service-name>.<namespace>.svc.cluster.local
# 3. Store ALL sensitive data in Kubernetes Secrets:
#    - Database passwords
#    - Keycloak credentials
#    - Email credentials
#    - RabbitMQ credentials
#    - Redis password
#    - PayOS credentials
# 4. Use ConfigMaps for non-sensitive configuration
# 5. For production, replace H2 with PostgreSQL
# 6. Update CORS_ALLOWED_ORIGINS with your actual frontend domain
# 7. Update PayOS callback URLs with your actual ingress URLs
# 8. EUREKA_INSTANCE_ID should use ${HOSTNAME} (pod name in K8s)
# 9. Set EUREKA_PREFER_IP_ADDRESS=false to use DNS names
# 10. Enable Prometheus endpoints for monitoring

# ============================================
# LOCAL DEVELOPMENT VALUES (for reference)
# ============================================
# For local development, use these values instead:
#
# SERVER_PORT_DISCOVERY=8761
# SERVER_PORT_GATEWAY=9000
# SERVER_PORT_USER=8085
# SERVER_PORT_BASKET=8081
# SERVER_PORT_MENU=8080
# SERVER_PORT_ORDERING=8082
# SERVER_PORT_PAYMENT=8083
#
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# EUREKA_URI=http://localhost:8761/eureka/
# EUREKA_PREFER_IP_ADDRESS=true
# EUREKA_INSTANCE_ID=${random.value}
#
# KEYCLOAK_SERVER_URL=http://localhost:8180
# KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/master
#
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
#
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest
#
# DB_URL=jdbc:h2:mem:testdb
# DB_USERNAME=sa
# DB_PASSWORD=
# DB_DRIVER=org.h2.Driver
# H2_CONSOLE_ENABLED=true
# JPA_DIALECT=org.hibernate.dialect.H2Dialect
#
# PAYOS_RETURN_URL=http://localhost:3000/payment-success
# PAYOS_CANCEL_URL=http://localhost:9000/api/payment/cancel
# PAYOS_FE_CANCEL_URL=http://localhost:3000/payment-cancel

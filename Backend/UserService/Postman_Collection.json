{
  "info": {
    "_postman_id": "beef-restaurant-user-service",
    "name": "Beef Restaurant - User Service API",
    "description": "Complete API test collection for User Service with Keycloak integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"

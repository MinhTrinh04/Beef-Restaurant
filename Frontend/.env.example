# Environment Variables for Frontend

# API Gateway Base URL
# This is the main entry point for all backend API calls
# The gateway will route requests to appropriate microservices
NEXT_PUBLIC_API_BASE=http://localhost:9000

# NextAuth Configuration
# Used for authentication with Keycloak
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Keycloak Configuration
# SSO authentication provider
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_ISSUER=http://localhost:8180/realms/master
